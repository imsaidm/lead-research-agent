# Copy to .env (never commit .env). Only needed for real (non --mock) runs.
ANTHROPIC_API_KEY=
# Optional overrides
LEAD_AGENT_MODEL=claude-haiku-4-5-20251001
# Shown in the User-Agent so site owners and OSM operators can reach you.
# Use a real address you read (placeholder domains like example.com are rejected; OSM blocks them).
LEAD_AGENT_CONTACT=
# Hard cost cap per run in USD (agent + drafts).
LEAD_AGENT_BUDGET_USD=0.50
